generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}
enum UserStatus {
  ACTIVE
  DISABLED
}
enum RoomVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}
enum RoomStatus {
  ACTIVE
  ARCHIVED
}
enum PrincipalType {
  USER
  ASSISTANT
}
enum RoomRole {
  MEMBER
  MODERATOR
  OWNER
}
enum MessageKind {
  TEXT
  AI
  SYSTEM
}
enum AiRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
}
enum AuditResult {
  SUCCESS
  FAILURE
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  displayName  String
  avatarKey    String?
  role         UserRole    @default(USER)
  status       UserStatus  @default(ACTIVE)
  roleId       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sessions     Session[]
  memberships  RoomMember[]
  roomsCreated Room[]      @relation("RoomCreator")
  auditLogs    AuditLog[]
  assignedRole Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Room {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  visibility   RoomVisibility @default(PUBLIC)
  status       RoomStatus   @default(ACTIVE)
  createdById  String
  lastSequence Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    User         @relation("RoomCreator", fields: [createdById], references: [id])
  members      RoomMember[]
  messages     Message[]
  @@index([visibility, status, updatedAt])
}

model RoomMember {
  id            String        @id @default(cuid())
  roomId        String
  principalType PrincipalType
  userId        String?
  assistantKey  String?
  roomRole      RoomRole      @default(MEMBER)
  joinedAt      DateTime      @default(now())
  leftAt        DateTime?
  version       Int           @default(1)
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentMessages  Message[]     @relation("MessageSender")
  mentions      MessageMention[]
  aiRunsCalled  AiRun[]       @relation("AiCaller")
  @@index([roomId, leftAt])
  @@index([userId, roomId, leftAt])
  @@unique([roomId, assistantKey])
}

model Message {
  id             String          @id @default(cuid())
  roomId         String
  senderMemberId String
  kind           MessageKind     @default(TEXT)
  body           String
  contentParts   Json?
  clientId       String?
  roomSequence   Int
  replyToId      String?
  createdAt      DateTime        @default(now())
  deletedAt      DateTime?
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderMember   RoomMember      @relation("MessageSender", fields: [senderMemberId], references: [id])
  replyTo        Message?        @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]       @relation("MessageReplies")
  mentions       MessageMention[]
  aiTrigger      AiRun?           @relation("AiTrigger")
  aiResponse     AiRun?           @relation("AiResponse")
  @@unique([roomId, roomSequence])
  @@unique([roomId, senderMemberId, clientId])
  @@index([roomId, createdAt])
}

model MessageMention {
  id        String      @id @default(cuid())
  messageId String
  memberId  String
  start     Int
  end       Int
  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member    RoomMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@unique([messageId, memberId, start, end])
  @@index([messageId, memberId])
}

model AiRun {
  id                       String      @id @default(cuid())
  triggerMessageId         String      @unique
  callerMemberId           String
  authorizationPolicyVersion Int       @default(1)
  providerConfigVersion    Int?
  requestId                String
  status                   AiRunStatus @default(PENDING)
  owner                    String?
  leaseGeneration          Int         @default(0)
  leaseExpiresAt           DateTime?
  attempt                  Int         @default(0)
  nextRetryAt              DateTime?
  errorCode                String?
  tokenUsage               Int?
  latencyMs                Int?
  responseMessageId        String?     @unique
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  triggerMessage           Message     @relation("AiTrigger", fields: [triggerMessageId], references: [id])
  callerMember             RoomMember  @relation("AiCaller", fields: [callerMemberId], references: [id])
  responseMessage          Message?    @relation("AiResponse", fields: [responseMessageId], references: [id])
  @@index([status, nextRetryAt, leaseExpiresAt])
}

model Model {
  id         String   @id @default(cuid())
  name       String   @unique
  modelId    String
  baseUrl    String
  secretRef  String?
  ciphertext String?
  timeoutMs  Int      @default(30000)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  agents     Agent[]
  @@index([enabled])
}

model Agent {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String   @default("")
  systemPrompt String   @default("")
  mcpConfig    Json?
  avatarKey    String?
  primaryColor String?
  modelId      String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  model        Model?   @relation(fields: [modelId], references: [id], onDelete: SetNull)
  skills       AgentSkill[]
  @@index([enabled])
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  source      String   @default("URL")
  sourceRef   String?
  manifest    Json?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agents      AgentSkill[]
}

model AgentSkill {
  agentId String
  skillId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@unique([agentId, skillId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String   @default("")
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([roleId, permissionId])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  result     AuditResult @default(SUCCESS)
  requestId  String?
  createdAt  DateTime    @default(now())
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([createdAt, id])
  @@index([actorId, action, createdAt])
}
