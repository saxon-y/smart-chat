generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum RoomStatus {
  ACTIVE
  ARCHIVED
}

enum PrincipalType {
  USER
  ASSISTANT
}

enum RoomRole {
  MEMBER
  MODERATOR
  OWNER
}

enum RoomJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum RoomInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

enum MessageKind {
  TEXT
  AI
  SYSTEM
}

enum AgentKind {
  SUPERVISOR
  CHAT
  IMAGE
}

enum ModelProviderType {
  OPENAI_COMPATIBLE
  OPENAI_IMAGES
  GEMINI_IMAGES
  CUSTOM
}

enum AiRunMode {
  DIRECT
  SUPERVISOR
  DELEGATED
}

enum AiRunStatus {
  PENDING
  PREPARING
  READY
  CLAIMED
  RUNNING
  WAITING_APPROVAL
  PAUSED
  RETRY_WAIT
  BLOCKED
  SUCCEEDED
  NO_ACTION
  CANCELLED
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum AuditResult {
  SUCCESS
  FAILURE
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  passwordHash         String
  displayName          String
  avatarKey            String?
  role                 UserRole          @default(USER)
  status               UserStatus        @default(ACTIVE)
  roleId               String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  sessions             Session[]
  memberships          RoomMember[]
  roomsCreated         Room[]            @relation("RoomCreator")
  auditLogs            AuditLog[]
  assignedRole         Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  joinRequests         RoomJoinRequest[]
  reviewedJoinRequests RoomJoinRequest[] @relation("JoinRequestReviewer")
  invitationsSent      RoomInvitation[]  @relation("InvitationInviter")
  invitationsReceived  RoomInvitation[]  @relation("InvitationInvitee")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Room {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  visibility   RoomVisibility    @default(PUBLIC)
  status       RoomStatus        @default(ACTIVE)
  createdById  String
  lastSequence Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  createdBy    User              @relation("RoomCreator", fields: [createdById], references: [id])
  members      RoomMember[]
  messages     Message[]
  supervisor   RoomSupervisor?
  aiRuns       AiRun[]
  outboxEvents OutboxEvent[]
  joinRequests RoomJoinRequest[]
  invitations  RoomInvitation[]

  @@index([visibility, status, updatedAt])
}

model RoomMember {
  id             String           @id @default(cuid())
  roomId         String
  principalType  PrincipalType
  userId         String?
  assistantKey   String?
  roomRole       RoomRole         @default(MEMBER)
  joinedAt       DateTime         @default(now())
  leftAt         DateTime?
  version        Int              @default(1)
  mutedUntil     DateTime?
  room           Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentMessages   Message[]        @relation("MessageSender")
  mentions       MessageMention[]
  aiRunsCalled   AiRun[]          @relation("AiCaller")
  aiRunsTargeted AiRun[]          @relation("AiRunTargetMember")

  @@index([roomId, leftAt])
  @@index([userId, roomId, leftAt])
  @@index([roomId, assistantKey, leftAt])
}

model RoomJoinRequest {
  id           String                @id @default(cuid())
  roomId       String
  userId       String
  status       RoomJoinRequestStatus @default(PENDING)
  reason       String?
  reviewedById String?
  reviewedAt   DateTime?
  reviewReason String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  room         Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?                 @relation("JoinRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([roomId, status, createdAt])
  @@index([userId, status, createdAt])
}

model RoomInvitation {
  id          String               @id @default(cuid())
  roomId      String
  inviterId   String
  inviteeId   String
  status      RoomInvitationStatus @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  respondedAt DateTime?
  room        Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inviter     User                 @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User                 @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
  @@index([inviteeId, status])
}

model Message {
  id             String           @id @default(cuid())
  roomId         String
  senderMemberId String
  kind           MessageKind      @default(TEXT)
  body           String
  contentParts   Json?
  clientId       String?
  roomSequence   Int
  replyToId      String?
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  room           Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderMember   RoomMember       @relation("MessageSender", fields: [senderMemberId], references: [id])
  replyTo        Message?         @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]        @relation("MessageReplies")
  mentions       MessageMention[]
  aiTrigger      AiRun[]          @relation("AiTrigger")
  aiResponse     AiRun?           @relation("AiResponse")

  @@unique([roomId, roomSequence])
  @@unique([roomId, senderMemberId, clientId])
  @@index([roomId, createdAt])
}

model MessageMention {
  id        String     @id @default(cuid())
  messageId String
  memberId  String
  start     Int
  end       Int
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member    RoomMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId, start, end])
  @@index([messageId, memberId])
}

model AiRun {
  id                         String               @id @default(cuid())
  triggerMessageId           String
  roomId                     String
  callerMemberId             String
  mode                       AiRunMode            @default(DIRECT)
  parentRunId                String?
  targetAgentId              String?
  targetMemberId             String?
  configVersion              Int?
  membershipVersion          Int?
  decision                   String?
  decisionConfidence         Float?
  decisionReasonCode         String?
  authorizationPolicyVersion Int                  @default(1)
  providerConfigVersion      Int?
  runtimeId                  String?
  runtimeKind                String?
  runtimeVersion             String?
  taskDigest                 String?
  contextGeneration          Int                  @default(0)
  skillBundleHash            String?
  mcpBundleDigest            String?
  checkpointSequence         Int                  @default(0)
  cancelRequestedAt          DateTime?
  blockedReason              String?
  requestId                  String
  idempotencyKey             String?              @unique
  status                     AiRunStatus          @default(PENDING)
  owner                      String?
  leaseGeneration            Int                  @default(0)
  leaseExpiresAt             DateTime?
  attempt                    Int                  @default(0)
  nextRetryAt                DateTime?
  errorCode                  String?
  tokenUsage                 Int?
  inputTokens                Int                  @default(0)
  outputTokens               Int                  @default(0)
  toolCallCount              Int                  @default(0)
  costMicros                 Int                  @default(0)
  latencyMs                  Int?
  responseMessageId          String?              @unique
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  room                       Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  triggerMessage             Message              @relation("AiTrigger", fields: [triggerMessageId], references: [id])
  callerMember               RoomMember           @relation("AiCaller", fields: [callerMemberId], references: [id])
  responseMessage            Message?             @relation("AiResponse", fields: [responseMessageId], references: [id])
  parentRun                  AiRun?               @relation("AiRunParent", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns                  AiRun[]              @relation("AiRunParent")
  targetAgent                Agent?               @relation("AiRunTargetAgent", fields: [targetAgentId], references: [id], onDelete: SetNull)
  targetMember               RoomMember?          @relation("AiRunTargetMember", fields: [targetMemberId], references: [id], onDelete: SetNull)
  artifacts                  Artifact[]
  outboxEvents               OutboxEvent[]
  runtime                    AgentRuntime?        @relation(fields: [runtimeId], references: [id], onDelete: SetNull)
  runEvents                  AgentRunEvent[]
  runTurns                   AgentRunTurn[]
  runCheckpoints             AgentRunCheckpoint[]
  toolCalls                  AgentToolCall[]
  approvals                  AgentApproval[]

  @@unique([triggerMessageId, mode])
  @@unique([parentRunId, targetMemberId])
  @@index([roomId, status, nextRetryAt, leaseExpiresAt])
  @@index([targetMemberId, status])
  @@index([status, nextRetryAt, leaseExpiresAt])
  @@index([runtimeId, status, nextRetryAt, leaseExpiresAt])
}

model AgentRuntime {
  id              String    @id
  kind            String
  endpoint        String?
  capabilities    Json
  status          String
  version         String?
  lastHeartbeatAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  runs            AiRun[]

  @@index([status, lastHeartbeatAt])
  @@index([kind, status])
}

model AgentRunEvent {
  id          String               @id @default(cuid())
  runId       String
  sequence    Int
  type        String
  payload     Json
  createdAt   DateTime             @default(now())
  run         AiRun                @relation(fields: [runId], references: [id], onDelete: Restrict)
  checkpoints AgentRunCheckpoint[] @relation("CheckpointEvent")

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@index([type, createdAt])
}

model AgentRunTurn {
  id                  String               @id @default(cuid())
  runId               String
  turnIndex           Int
  inputDigest         String
  prefixDigest        String
  loadedSkillIds      Json
  loadedToolSchemaIds Json
  providerRequestId   String?
  status              String               @default("STARTED")
  assistantContent    Json?
  thinking            Json?
  thinkingContinuity  String               @default("NONE")
  finishReason        String?
  usage               Json?
  startedAt           DateTime             @default(now())
  completedAt         DateTime?
  run                 AiRun                @relation(fields: [runId], references: [id], onDelete: Restrict)
  checkpoints         AgentRunCheckpoint[] @relation("CheckpointTurn")
  toolCalls           AgentToolCall[]

  @@unique([runId, turnIndex])
  @@index([runId, status, startedAt])
  @@index([providerRequestId])
}

model AgentRunCheckpoint {
  id                  String        @id @default(cuid())
  runId               String
  turnIndex           Int
  eventSequence       Int
  runtimeSessionId    String?
  taskDigest          String
  contextGeneration   Int
  skillBundleHash     String
  mcpBundleDigest     String
  loadedSkillIds      Json
  loadedToolSchemaIds Json
  inboundSequence     Int           @default(0)
  cumulativeUsage     Json
  summary             Json?
  createdAt           DateTime      @default(now())
  run                 AiRun         @relation(fields: [runId], references: [id], onDelete: Restrict)
  turn                AgentRunTurn  @relation("CheckpointTurn", fields: [runId, turnIndex], references: [runId, turnIndex], onDelete: Restrict)
  event               AgentRunEvent @relation("CheckpointEvent", fields: [runId, eventSequence], references: [runId, sequence], onDelete: Restrict)

  @@unique([runId, eventSequence])
  @@index([runId, turnIndex])
  @@index([runtimeSessionId])
}

model AgentToolCall {
  id               String          @id
  runId            String
  turnIndex        Int
  toolId           String
  toolVersion      String
  arguments        Json
  argumentsDigest  String
  risk             String
  concurrency      String
  status           String          @default("PENDING")
  idempotencyKey   String?         @unique
  result           Json?
  resultOrigin     String?
  resultArtifactId String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  run              AiRun           @relation(fields: [runId], references: [id], onDelete: Restrict)
  turn             AgentRunTurn    @relation(fields: [runId, turnIndex], references: [runId, turnIndex], onDelete: Restrict)
  resultArtifact   Artifact?       @relation("ToolCallResultArtifact", fields: [resultArtifactId], references: [id], onDelete: SetNull)
  approvals        AgentApproval[]

  @@unique([runId, id])
  @@index([runId, turnIndex])
  @@index([runId, status, createdAt])
}

model AgentApproval {
  id              String        @id @default(cuid())
  runId           String
  toolCallId      String
  argumentsDigest String
  status          String        @default("PENDING")
  requestedAt     DateTime      @default(now())
  decidedAt       DateTime?
  decidedBy       String?
  decisionReason  String?
  run             AiRun         @relation(fields: [runId], references: [id], onDelete: Restrict)
  toolCall        AgentToolCall @relation(fields: [runId, toolCallId], references: [runId, id], onDelete: Restrict)

  @@unique([runId, toolCallId, argumentsDigest])
  @@index([status, requestedAt])
  @@index([runId, status])
}

model Model {
  id           String            @id @default(cuid())
  name         String            @unique
  modelId      String
  baseUrl      String
  secretRef    String?
  ciphertext   String?
  providerType ModelProviderType @default(OPENAI_COMPATIBLE)
  timeoutMs    Int               @default(30000)
  enabled      Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  agents       Agent[]

  @@index([enabled])
}

model Agent {
  id              String           @id @default(cuid())
  key             String           @unique
  name            String
  description     String           @default("")
  systemPrompt    String           @default("")
  kind            AgentKind        @default(CHAT)
  capabilities    String[]         @default([])
  mcpConfig       Json?
  avatarKey       String?
  primaryColor    String?
  modelId         String?
  enabled         Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  model           Model?           @relation(fields: [modelId], references: [id], onDelete: SetNull)
  skills          AgentSkill[]
  supervisorRooms RoomSupervisor[] @relation("SupervisorAgent")
  targetRuns      AiRun[]          @relation("AiRunTargetAgent")

  @@index([enabled])
}

model RoomSupervisor {
  id                  String   @id @default(cuid())
  roomId              String   @unique
  agentId             String
  enabled             Boolean  @default(true)
  confidenceThreshold Float    @default(0.75)
  configVersion       Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  room                Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  agent               Agent    @relation("SupervisorAgent", fields: [agentId], references: [id], onDelete: Restrict)

  @@index([agentId, enabled])
}

model Artifact {
  id               String          @id @default(cuid())
  runId            String?
  objectKey        String
  mimeType         String
  width            Int?
  height           Int?
  byteSize         Int?
  sha256           String?
  providerMetadata Json?
  moderationStatus String?
  expiresAt        DateTime?
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  run              AiRun?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  toolCallResults  AgentToolCall[] @relation("ToolCallResultArtifact")

  @@unique([objectKey])
  @@index([runId, createdAt])
  @@index([expiresAt, deletedAt])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  roomId      String
  runId       String?
  messageId   String?
  type        String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  run         AiRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([publishedAt, createdAt])
  @@index([roomId, createdAt])
}

model Skill {
  id          String          @id @default(cuid())
  name        String          @unique
  description String          @default("")
  source      String          @default("URL")
  sourceRef   String?
  manifest    Json?
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  agents      AgentSkill[]
  revisions   SkillRevision[]
}

model SkillRevision {
  id         String   @id @default(cuid())
  skillId    String
  version    Int
  bundleHash String   @unique
  manifest   Json
  content    Json
  createdAt  DateTime @default(now())
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([skillId, version])
  @@index([skillId, createdAt])
}

model McpConfigRevision {
  id            String   @id @default(cuid())
  configId      String
  revision      Int
  config        Json
  approvedTools Json
  schemaDigest  String
  createdAt     DateTime @default(now())

  @@unique([configId, revision])
  @@index([configId, createdAt])
  @@index([schemaDigest])
}

model AgentSkill {
  agentId String
  skillId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String           @default("")
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String           @default("")
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  result     AuditResult @default(SUCCESS)
  requestId  String?
  createdAt  DateTime    @default(now())
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@index([actorId, action, createdAt])
}
