DATABASE_URL="postgresql://smart_chat:smart_chat@localhost:5432/smart_chat?schema=public"
POSTGRES_PASSWORD="smart_chat"
POSTGRES_PORT="5432"
APP_PORT="3000"
SMART_CHAT_IMAGE_TAG="latest"
PUBLIC_HOST="43-130-52-92.sslip.io"
SESSION_SECRET="replace-with-at-least-32-random-characters"
AI_CONFIG_ENCRYPTION_KEY="replace-with-an-independent-32-character-secret"
LOCAL_AI_API_KEY=""
LOCAL_AI_BASE_URL="http://localhost:4000/v1"
LOCAL_AI_MODEL="local-model"
SEED_ADMIN_PASSWORD="admin-password-change-me"
SEED_DEMO_PASSWORD="demo-password-change-me"
# 仅在 HTTPS 部署时设为 true；HTTP 局域网访问保持空/false
COOKIE_SECURE=""
AGENT_WORKER_SECRET="replace-with-a-long-random-worker-secret"
AGENT_WORKER_URL="http://localhost:3000/api/internal/agent-worker"
AI_PROVIDER_HOST_ALLOWLIST="api.openai.com,generativelanguage.googleapis.com"
# 生产环境必须指向持久化私有卷；本地开发默认使用 .data/
ARTIFACT_STORAGE_DIR=""
IMAGE_PROMPT_BLOCKLIST=""
ARTIFACT_STORAGE_BACKEND="local"
ARTIFACT_RETENTION_DAYS="30"
AGENT_RUNTIME_MODE=legacy
# Optional deterministic canary controls. Explicit room/agent/kind lists override percentage assignment.
AGENT_RUNTIME_CANARY_MODE=embedded
AGENT_RUNTIME_CANARY_PERCENT=0
AGENT_RUNTIME_CANARY_ROOM_IDS=
AGENT_RUNTIME_CANARY_AGENT_IDS=
AGENT_RUNTIME_CANARY_KINDS=
# 独立 Runtime 默认不会启动或消费 legacy Run。启用前必须提供已实现 executeClaimedRun 的绝对模块路径。
SELF_HOSTED_RUNTIME_ID=self-hosted-local
SELF_HOSTED_RUNTIME_EXECUTOR=
SELF_HOSTED_RUNTIME_CONCURRENCY=4
SELF_HOSTED_RUNTIME_SCAN_INTERVAL_MS=1000
SELF_HOSTED_RUNTIME_LEASE_MS=30000
SELF_HOSTED_RUNTIME_HEARTBEAT_MS=5000
SELF_HOSTED_RUNTIME_INACTIVITY_TIMEOUT_MS=120000
SELF_HOSTED_RUNTIME_MAX_RUN_TIME_MS=900000
SELF_HOSTED_RUNTIME_HEALTH_PORT=3011
